# RightAware environment variables — COPY to .env (local) or set in Vercel dashboard.
# NEVER commit real values. Frontend code must only use PUBLIC keys (see js/config.js).
# Full guide: ENVIRONMENT.md

# --- Supabase (backend: auth, database, storage) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key is SERVER-ONLY (Vercel env vars, never NEXT_PUBLIC_/frontend):
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (payments) ---
# Public key may be exposed to the frontend via window.__ENV__:
PAYSTACK_PUBLIC_KEY=
# Secret key is SERVER-ONLY (used by /api/paystack/*):
PAYSTACK_SECRET_KEY=

# --- AI backend ---
# SERVER-ONLY (used by /api/ai/chat). The browser never sees these:
# Google Gemini (recommended, AIzaSy...) or OpenAI (sk-...)
AI_API_KEY=             # required - without it /api/ai/chat answers 501 and the site falls back to labelled library matches
AI_MODEL=               # optional - defaults to gpt-4o-mini
AI_BASE_URL=            # optional - defaults to https://api.openai.com/v1/chat/completions (any OpenAI-compatible endpoint)
AI_MODEL=               # optional - defaults to gemini-3.8-flash for Gemini or gpt-4o-mini for OpenAI
AI_BASE_URL=            # optional - defaults to https://generativelanguage.googleapis.com/v1beta/openai/chat/completions (Gemini)
GUEST_HMAC_SECRET=      # required in production for guest AI preview cookie signing (or set SUPABASE_SERVICE_ROLE_KEY)

# --- Indigenous Speech TTS (Edge Function / Naija Speech) ---
# SERVER-ONLY (set in Supabase via `supabase secrets set NAIJA_SPEECH_API_KEY=...`):
NAIJA_SPEECH_API_KEY=   # official API key from https://asr.naijallm.com/ (powers en, yo, ig, ha synthesis)
TTS_ENDPOINT=           # optional frontend override (defaults to /functions/v1/synthesize-indigenous-speech)

# --- App ---
APP_ENV=development
PORT=3005
SUPPORT_EMAIL=hello@rightaware.ng
