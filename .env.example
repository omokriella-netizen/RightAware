# RightAware environment variables — COPY to .env (local) or set in Vercel dashboard.
# NEVER commit real values. Frontend code must only use PUBLIC keys (see js/config.js).
# Full guide: ENVIRONMENT.md

# --- Supabase (backend: auth, database, storage) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key is SERVER-ONLY (Vercel env vars, never NEXT_PUBLIC_/frontend):
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (payments) ---
# Public key may be exposed to the frontend via window.__ENV__:
PAYSTACK_PUBLIC_KEY=
# Secret key is SERVER-ONLY (used by /api/paystack/*):
PAYSTACK_SECRET_KEY=

# --- AI backend ---
# SERVER-ONLY (used by /api/ai/chat). The browser never sees this key:
AI_API_KEY=
AI_MODEL=

# --- Cloudflare Turnstile (CAPTCHA on Sign Up / Login / Password Reset) ---
# PUBLIC site key — safe in the browser (copied to env.local.js by tools\make-env.ps1):
TURNSTILE_SITE_KEY=
# SECRET key is SERVER-ONLY — never in frontend code, never in git.
# Configure it in: Supabase Dashboard → Authentication → Settings →
# CAPTCHA provider = Cloudflare Turnstile → paste the Cloudflare SECRET key.
# Then enable CAPTCHA there. Supabase verifies the token; the browser only
# ever holds the public site key above.
TURNSTILE_SECRET_KEY=

# --- App ---
APP_ENV=development
SUPPORT_EMAIL=hello@rightaware.ng
