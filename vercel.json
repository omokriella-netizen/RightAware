{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "trailingSlash": false,
  "buildCommand": "node tools/make-env.vercel.js",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/api/(.*)\\.js", "destination": "/api/$1" },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/account", "destination": "/account.html", "permanent": true },
    { "source": "/admin", "destination": "/admin.html", "permanent": true },
    { "source": "/ai", "destination": "/ai.html", "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/help", "destination": "/help.html", "permanent": true },
    { "source": "/laws", "destination": "/laws.html", "permanent": true },
    { "source": "/lawyers", "destination": "/lawyers.html", "permanent": true },
    { "source": "/login", "destination": "/login.html", "permanent": true },
    { "source": "/offline", "destination": "/offline.html", "permanent": true },
    { "source": "/organizations", "destination": "/organizations.html", "permanent": true },
    { "source": "/organization", "destination": "/organization.html", "permanent": true },
    { "source": "/resources", "destination": "/resources.html", "permanent": true },
    { "source": "/rights", "destination": "/rights.html", "permanent": true },
    { "source": "/search", "destination": "/search.html", "permanent": true },
    { "source": "/signup", "destination": "/signup.html", "permanent": true },
    { "source": "/videos", "destination": "/videos.html", "permanent": true },
    { "source": "/rights/topic", "destination": "/rights/topic.html", "permanent": true },
    { "source": "/rights/arrest-rights", "destination": "/rights/arrest-rights.html", "permanent": true },
    { "source": "/printables", "destination": "/printables.html", "permanent": true },
    { "source": "/professional", "destination": "/professional.html", "permanent": true },
    { "source": "/docs/(.*)", "destination": "/blocked", "permanent": false },
    { "source": "/supabase/(.*)", "destination": "/blocked", "permanent": false },
    { "source": "/tools/(.*)", "destination": "/blocked", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com; img-src 'self' data: blob: https://mfipmwfzkmipaevgshye.supabase.co; connect-src 'self' https://challenges.cloudflare.com https://mfipmwfzkmipaevgshye.supabase.co wss://mfipmwfzkmipaevgshye.supabase.co; media-src 'self' blob: data:; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(login|signup|account|admin|professional|organization)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
